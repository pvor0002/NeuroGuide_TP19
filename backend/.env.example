APP_NAME=NeuroGuide API
API_V1_PREFIX=/api/v1
DEBUG=true

# Google AI Studio / Gemini: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Comma-separated allowed frontend origins for browser requests (exact match).
# Production custom domains are also allowed via allow_origin_regex in app/main.py.
# On Lambda, set CORS_ORIGINS to every live site origin (www + apex), e.g.:
# CORS_ORIGINS=https://www.neuroguide.dev,https://neuroguide.dev
# Include every local Vite port you use (5173, 5174, …) and production domains.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174

# PostgreSQL — required for /api/v1/pg/* routes
DATABASE_URL=

# Long random secret for pass-key hashing — required for /api/v1/pg/session/*
PASS_KEY_PEPPER=
