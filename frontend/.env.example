# Vite asset + router base (default "/"). Use "/iteration_1/" only if the built app is
# served from that URL path. Standalone Vercel previews (e.g. *.vercel.app) should use "/".
# VITE_BASE_PATH=/

# Backend API base (optional; see jobDescriptionApi.js for defaults)
# Local example:
# VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1
# Production example (Render):
#
# Set to 1 to skip /pg/session cloud registration + sync (local-only mode).
# VITE_DISABLE_CLOUD_SESSION=

# Set to 0 to hide simplify features when no backend is available
# VITE_SIMPLIFY_API=1

# Optional site gate: when set to a non-empty value, visitors must enter this
# password once per browser session before the app loads. The value is embedded
# in the client build—use hosting HTTP Basic Auth or similar for real secrecy.
# You can put this in EITHER frontend/.env OR the repo root .env (same folder as
# backend/). Restart `npm run dev` after changing.
# VITE_SITE_PASSWORD=
